# Serveur
PORT=3000
DATA_DIR=./var

# Sécurité (OBLIGATOIRE en production : chaînes longues et aléatoires, ex. `openssl rand -hex 32`)
HASH_SECRET=
ENCRYPTION_KEY=
ADMIN_TOKEN=

# Discrétion
CODE_WORD=mango
# Délai du rappel de suivi en minutes : 4320 = 3 jours ; mettre 1 pour une démo
FOLLOWUP_DELAY_MINUTES=4320
ALERT_RETENTION_DAYS=90
SESSION_RETENTION_DAYS=60
STATS_THRESHOLD=10

# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_FOLLOWUP_TEMPLATE=

# Numéro WhatsApp du relais qui reçoit les alertes (format international sans +, ex. 221770000000)
RELAY_WHATSAPP=

# IA optionnelle (reformulation ancrée sur les fiches)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
