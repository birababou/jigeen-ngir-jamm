# Copier ce fichier en deploy/deploy.env puis compléter. Ne jamais le commiter.

# Accès SSH au serveur
SERVER_USER=
SERVER_HOST=
SERVER_PORT=22

# Dossier de l'application sur le serveur (sera créé s'il n'existe pas)
REMOTE_DIR=

# Nom de domaine (ou sous-domaine) déjà pointé vers l'IP du serveur (enregistrement DNS A)
DOMAIN=

# E-mail pour le certificat HTTPS (Let's Encrypt)
CERTBOT_EMAIL=

# Port interne de l'application (choisir un port libre sur le serveur)
APP_PORT=3100

# Nom du service systemd
SERVICE_NAME=jigeen-ngir-jamm
